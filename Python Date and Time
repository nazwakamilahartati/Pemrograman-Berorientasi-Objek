#Python datetime.timedelta Class
#Difference between two dates and times
from datetime import datetime, date

# using date()
t1 = date(year=2025, month=8, day=21)
t2 = date(year=2024, month=5, day=10)

t3 = t1 - t2

print("t3 =", t3)

# using datetime()
t4 = datetime(year=2025, month=8, day=21, hour=14, minute=25, second=36)
t5 = datetime(year=2024, month=5, day=10, hour=10, minute=20, second=15)
t6 = t4 - t5
print("t6 =", t6)

print("Type of t3 =", type(t3))
print("Type of t6 =", type(t6))
print()

#Example 12: Difference between two timedelta objects
