t2 = timedelta(days=5, hours=8, minutes=15, seconds=30)

t3 = t1 - t2

print("t3 =", t3)
print()

#Example 14: Time duration in seconds
from datetime import timedelta

t = timedelta(days=3, hours=2, seconds=45, microseconds=114036)
print("Total seconds =", t.total_seconds())
print()

